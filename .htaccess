<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny access to sensitive directories
  RewriteRule ^config/ - [F,L]
  RewriteRule ^storage/ - [F,L]
  RewriteRule ^docker/ - [F,L]
  RewriteRule ^vendor/ - [F,L]

  # Set flag for localhost requests
  RewriteCond %{HTTP_HOST} ^localhost [NC,OR]
  RewriteCond %{HTTP_HOST} ^127\.0\.0\. [NC]
  RewriteRule ^ - [E=IS_LOCAL:1]

  # Undo cached HTTPS redirect on localhost
  RewriteCond %{ENV:IS_LOCAL} 1
  RewriteCond %{HTTPS} on
  RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Redirect HTTP to HTTPS (production only)
  RewriteCond %{ENV:IS_LOCAL} !1
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Redirect .php URLs to clean URLs (production only)
  RewriteCond %{ENV:IS_LOCAL} !1
  RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # Internally rewrite clean URLs to .php files
  RewriteCond %{REQUEST_URI} !^/admin/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# Return 404 for .env files (avoids security scanner triggers)
RedirectMatch 404 /\.env

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|webp|png|svg|gif|ico)$">
    Header set Cache-Control "public, immutable, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff|ttf)$">
    Header set Cache-Control "public, immutable, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript image/svg+xml font/ttf
</IfModule>
